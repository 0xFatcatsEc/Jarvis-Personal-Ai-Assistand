# Copy to .env (git-ignored) and fill in only what you use.
# Jarvis runs fully local with none of these set.

# Cloud LLM fallback (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Home Assistant (optional)
HOME_ASSISTANT_TOKEN=

# Web search: keyless by default (ddgs). Only needed if provider: tavily
TAVILY_API_KEY=
