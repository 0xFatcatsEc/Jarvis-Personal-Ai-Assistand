# secrets
.env
.env.*

# python
# Contents-only patterns (`dir/*`) keep the folders ignored while letting
# `git add <folder>` succeed instead of failing with "paths are ignored".
__pycache__/*
*.py[cod]
.venv/*
.pytest_cache/*
*.egg-info/*

# runtime state (personal data - never commit)
data/*
logs/*
notes/*
models/*
!data/.gitkeep
!logs/.gitkeep
!notes/.gitkeep
!models/.gitkeep

# os noise
.DS_Store
